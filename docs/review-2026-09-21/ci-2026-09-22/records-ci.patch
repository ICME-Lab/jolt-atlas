+  experimental-onnx-zk:
+    name: Experimental ONNX ZK (informational)
+    runs-on: ubuntu-latest
+    # This dispatcher still lacks several operator relations. Keep its build
+    # and complete test results visible without conflating it with native ZK.
+    continue-on-error: true
+    steps:
+      - uses: actions/checkout@v7.0.1
+      - uses: actions-rust-lang/setup-rust-toolchain@v1
+        with:
+          components: clippy
+      - name: Check experimental dispatcher
+        id: clippy
+        continue-on-error: true
+        run: cargo clippy -p jolt-atlas-core --all-targets --features zk
+      - uses: taiki-e/install-action@nextest
+      - name: Run experimental tests
+        id: tests
+        continue-on-error: true
+        run: cargo nextest run -p jolt-atlas-core --features zk --no-fail-fast
+      - name: Report experimental results
+        if: always()
+        env:
+          CLIPPY_OUTCOME: ${{ steps.clippy.outcome }}
+          TEST_OUTCOME: ${{ steps.tests.outcome }}
+        run: |
+          {
+            echo '## Experimental ONNX ZK'
+            echo 'The supported native BlindFold suite runs in Clippy & Test (zk).'
+            echo 'This separate ONNX dispatcher is incomplete and informational.'
+            echo "Clippy result: $CLIPPY_OUTCOME"
+            echo "Test result: $TEST_OUTCOME"
+            echo 'See the job logs for every compiler diagnostic and test failure.'
+          } >> "$GITHUB_STEP_SUMMARY"
+          if [[ "$CLIPPY_OUTCOME" != success || "$TEST_OUTCOME" != success ]]; then
+            echo '::warning::Experimental ONNX ZK failed. These results do not establish a working ONNX ZK dispatcher.'
+            exit 1
+          fi
